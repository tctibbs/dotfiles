#!/usr/bin/env pwsh
# Chezmoi run_once script for Windows: Runs once per machine
# Install profile: {{ .profile }}

$ErrorActionPreference = "Continue"

Write-Host ""
Write-Host "Installing packages for profile: {{ .profile }}" -ForegroundColor Blue
Write-Host ""

{{ if eq .profile "minimal" -}}
Write-Host "Minimal profile selected - skipping package installation" -ForegroundColor Yellow
Write-Host "Shell configuration applied. Run chezmoi with profile=lite or profile=full for tools."
exit 0
{{ end -}}

# Track results
$Installed = @()
$Skipped = @()
$Failed = @()

function Test-Command {
    param([string]$Command)
    return $null -ne (Get-Command $Command -ErrorAction SilentlyContinue)
}

# ============================================================================
# Package Manager Detection
# ============================================================================

$HasWinget = Test-Command winget
$HasScoop = Test-Command scoop

function Install-Tool {
    param(
        [string]$Command,
        [string]$WingetId,
        [string]$ScoopName
    )
    if (Test-Command $Command) {
        Write-Host "  $Command already installed" -ForegroundColor Green
        $script:Skipped += $Command
        return
    }
    Write-Host "  Installing $Command..." -ForegroundColor Yellow
    if ($HasWinget -and $WingetId) {
        winget install $WingetId --accept-package-agreements --accept-source-agreements 2>&1 | Out-Null
        if ($LASTEXITCODE -eq 0 -or (Test-Command $Command)) {
            Write-Host "  $Command installed (winget)" -ForegroundColor Green
            $script:Installed += $Command; return
        }
    }
    if ($HasScoop -and $ScoopName) {
        scoop install $ScoopName 2>&1 | Out-Null
        if ($LASTEXITCODE -eq 0 -or (Test-Command $Command)) {
            Write-Host "  $Command installed (scoop)" -ForegroundColor Green
            $script:Installed += $Command; return
        }
    }
    Write-Host "  Failed: $Command" -ForegroundColor Red
    $script:Failed += $Command
}

# ============================================================================
# CLI Tools (winget preferred, scoop fallback)
# ============================================================================

Write-Host "Installing CLI tools..." -ForegroundColor Cyan

Install-Tool "bat"       "sharkdp.bat"              "bat"
Install-Tool "fd"        "sharkdp.fd"               "fd"
Install-Tool "fzf"       "junegunn.fzf"             "fzf"
Install-Tool "zoxide"    "ajeetdsouza.zoxide"       "zoxide"
Install-Tool "eza"       "eza-community.eza"        "eza"
Install-Tool "delta"     "dandavison.delta"          "delta"
Install-Tool "fastfetch" "Fastfetch-cli.Fastfetch"  "fastfetch"
Install-Tool "lazygit"   "JesseDuffield.lazygit"    "lazygit"
Install-Tool "lazydocker" "JesseDuffield.lazydocker" "lazydocker"
Install-Tool "starship"  "Starship.Starship"        "starship"
Install-Tool "onefetch"  ""                         "extras/onefetch"
Install-Tool "dust"      ""                         "dust"
Install-Tool "procs"     ""                         "procs"

# tldr (command name differs from package)
if (-not (Test-Command tldr)) {
    Write-Host "  Installing tldr..." -ForegroundColor Yellow
    if ($HasWinget) { winget install tldr-pages.tlrc --accept-package-agreements --accept-source-agreements 2>&1 | Out-Null }
    if (-not (Test-Command tldr) -and $HasScoop) { scoop install tealdeer 2>&1 | Out-Null }
    if (Test-Command tldr) { Write-Host "  tldr installed" -ForegroundColor Green; $Installed += "tldr" }
    else { Write-Host "  Failed: tldr" -ForegroundColor Red; $Failed += "tldr" }
} else { Write-Host "  tldr already installed" -ForegroundColor Green; $Skipped += "tldr" }

# btop (name differs between winget/scoop)
if (-not (Test-Command btop)) {
    Write-Host "  Installing btop..." -ForegroundColor Yellow
    if ($HasWinget) { winget install aristocratos.btop4win --accept-package-agreements --accept-source-agreements 2>&1 | Out-Null }
    if (-not (Test-Command btop) -and $HasScoop) { scoop install btop4win 2>&1 | Out-Null }
    if (Test-Command btop) { Write-Host "  btop installed" -ForegroundColor Green; $Installed += "btop" }
    else { Write-Host "  Failed: btop" -ForegroundColor Red; $Failed += "btop" }
} else { Write-Host "  btop already installed" -ForegroundColor Green; $Skipped += "btop" }

# FiraCode Nerd Font via scoop nerd-fonts bucket
Write-Host ""
Write-Host "Installing FiraCode Nerd Font..." -ForegroundColor Cyan
if ($HasScoop) {
    $nfBucket = scoop bucket list 2>&1 | Select-String "nerd-fonts"
    if (-not $nfBucket) { scoop bucket add nerd-fonts 2>&1 | Out-Null }
    scoop install nerd-fonts/FiraCode-NF 2>&1 | Out-Null
    Write-Host "  FiraCode Nerd Font installed (scoop)" -ForegroundColor Green
    $Installed += "FiraCode-NF"
}

# ============================================================================
# Cargo Tools (requires Rust)
# ============================================================================

Write-Host ""
Write-Host "Installing Rust tools via cargo..." -ForegroundColor Cyan

# Install Rust: scoop preferred, winget fallback
if (-not (Test-Command cargo)) {
    Write-Host "  Installing Rust..." -ForegroundColor Yellow
    if ($HasScoop) {
        # mingw provides dlltool.exe required by the GNU Rust toolchain
        scoop install mingw rustup-gnu 2>&1 | Out-Null
        # scoop rustup-gnu persists data under scoop\persist, not ~/.cargo / ~/.rustup
        $env:RUSTUP_HOME = Join-Path $env:USERPROFILE "scoop\persist\rustup-gnu\.rustup"
        $env:CARGO_HOME  = Join-Path $env:USERPROFILE "scoop\persist\rustup-gnu\.cargo"
        $CargoPath = Join-Path $env:CARGO_HOME "bin"
        $MinGWBin = Join-Path $env:USERPROFILE "scoop\apps\mingw\current\bin"
        if (Test-Path $MinGWBin) { $env:PATH = "$MinGWBin;$env:PATH" }
    } elseif ($HasWinget) {
        winget install Rustlang.Rustup --accept-package-agreements --accept-source-agreements 2>&1 | Out-Null
        $CargoPath = Join-Path $env:USERPROFILE ".cargo\bin"
        if (Test-Command rustup) { rustup default stable 2>&1 | Out-Null }
    }
    if ($CargoPath -and (Test-Path $CargoPath)) { $env:PATH = "$CargoPath;$env:PATH" }
}

# Tools available in scoop (faster than cargo build)
$ScoopCargoTools = @{
    "yazi"    = "yazi"
    "onefetch" = "extras/onefetch"
    "dust"    = "dust"
    "procs"   = "procs"
    "difft"   = "difftastic"
}

# Tools only available via cargo install
$CargoOnlyTools = @{
    "mcat"   = "mcat"
    "treemd" = "treemd"
}

if ($HasScoop) {
    foreach ($cmd in $ScoopCargoTools.Keys) {
        $pkg = $ScoopCargoTools[$cmd]
        if (-not (Test-Command $cmd)) {
            Write-Host "  Installing $cmd (scoop)..." -ForegroundColor Yellow
            scoop install $pkg 2>&1 | Out-Null
            if (Test-Command $cmd) { Write-Host "  $cmd installed" -ForegroundColor Green; $Installed += $cmd }
            else { Write-Host "  Failed: $cmd" -ForegroundColor Red; $Failed += $cmd }
        } else {
            Write-Host "  $cmd already installed" -ForegroundColor Green; $Skipped += $cmd
        }
    }
}

if (Test-Command cargo) {
    foreach ($cmd in $CargoOnlyTools.Keys) {
        $crate = $CargoOnlyTools[$cmd]
        if (-not (Test-Command $cmd)) {
            Write-Host "  Installing $crate (cargo)..." -ForegroundColor Yellow
            $output = cargo install $crate 2>&1
            if ($LASTEXITCODE -eq 0) { Write-Host "  $cmd installed" -ForegroundColor Green; $Installed += $cmd }
            else { Write-Host "  Failed: $crate`n  $output" -ForegroundColor Red; $Failed += $cmd }
        } else {
            Write-Host "  $cmd already installed" -ForegroundColor Green; $Skipped += $cmd
        }
    }
    # gobang requires a pinned version
    if (-not (Test-Command gobang)) {
        Write-Host "  Installing gobang (cargo)..." -ForegroundColor Yellow
        $output = cargo install gobang --version 0.1.0-alpha.5 2>&1
        if ($LASTEXITCODE -eq 0) { Write-Host "  gobang installed" -ForegroundColor Green; $Installed += "gobang" }
        else { Write-Host "  Failed: gobang`n  $output" -ForegroundColor Red; $Failed += "gobang" }
    } else { Write-Host "  gobang already installed" -ForegroundColor Green; $Skipped += "gobang" }
} else {
    Write-Host "  Cargo not available - skipping cargo-only tools" -ForegroundColor Yellow
    $Failed += $CargoOnlyTools.Keys
    $Failed += "gobang"
}

{{ if eq .profile "full" -}}
# ============================================================================
# Full Profile: GUI Apps
# ============================================================================

Write-Host ""
Write-Host "Installing GUI apps (full profile)..." -ForegroundColor Cyan

# Try winget first, scoop extras as fallback
if ($HasWinget) {
    if (-not (Test-Command wezterm)) {
        winget install wez.wezterm --accept-package-agreements --accept-source-agreements 2>&1 | Out-Null
    }
    if (-not (Test-Command code)) {
        winget install Microsoft.VisualStudioCode --accept-package-agreements --accept-source-agreements 2>&1 | Out-Null
    }
} elseif ($HasScoop) {
    if (-not (Test-Command wezterm)) { scoop install extras/wezterm 2>&1 | Out-Null }
    if (-not (Test-Command code)) { scoop install extras/vscode 2>&1 | Out-Null }
}
Write-Host "  GUI apps done" -ForegroundColor Green

# ============================================================================
# VS Code Extensions
# ============================================================================

Write-Host ""
Write-Host "Installing VS Code extensions..." -ForegroundColor Cyan

if (Test-Command code) {
    $VsCodeExtensions = @(
        "Catppuccin.catppuccin-vsc",
        "Catppuccin.catppuccin-vsc-icons",
        "miguelsolorio.fluent-icons",
        "usernamehw.errorlens",
        "charliermarsh.ruff",
        "ms-vscode-remote.remote-ssh",
        "ms-vscode-remote.remote-ssh-edit",
        "ms-vscode-remote.remote-containers",
        "ms-vscode-remote.remote-wsl",
        "ms-vscode.remote-explorer",
        "bierner.markdown-mermaid",
        "eamodio.gitlens"
    )
    foreach ($ext in $VsCodeExtensions) {
        Write-Host "  Installing $ext..." -ForegroundColor Yellow
        code --install-extension $ext --force 2>&1 | Out-Null
        if ($LASTEXITCODE -eq 0) {
            Write-Host "  $ext installed" -ForegroundColor Green
            $Installed += $ext
        } else {
            Write-Host "  Failed: $ext" -ForegroundColor Red
            $Failed += $ext
        }
    }
} else {
    Write-Host "  code CLI not found - skipping extensions (install VS Code first)" -ForegroundColor Yellow
}

Write-Host ""
Write-Host "VS Code post-install steps:" -ForegroundColor Cyan
Write-Host "  1. Restart VS Code fully" -ForegroundColor White
Write-Host "  2. Ctrl+Shift+P -> 'Enable Custom CSS and JS Loader'" -ForegroundColor White
Write-Host "  3. Dismiss 'corrupt installation' warning (gear icon -> Don't Show Again)" -ForegroundColor White
{{ end -}}

# ============================================================================
# PowerShell Modules
# ============================================================================

Write-Host ""
Write-Host "Installing PowerShell modules..." -ForegroundColor Cyan

# Ensure NuGet provider is installed (required for Install-Module)
$hasNuGet = $true
$nugetProvider = Get-PackageProvider -Name NuGet -ErrorAction SilentlyContinue
if (-not $nugetProvider -or $nugetProvider.Version -lt [Version]"2.8.5.201") {
    Write-Host "  Installing NuGet provider..." -ForegroundColor Yellow
    try {
        Install-PackageProvider -Name NuGet -MinimumVersion 2.8.5.201 -Force -Scope CurrentUser | Out-Null
    } catch {
        Write-Host "  NuGet provider installation failed - skipping PowerShell modules" -ForegroundColor Yellow
        $hasNuGet = $false
    }
}

$PSModules = @("PSFzf", "Terminal-Icons", "CompletionPredictor")

if (-not $hasNuGet) {
    foreach ($moduleName in $PSModules) { $Failed += $moduleName }
} else {
    foreach ($moduleName in $PSModules) {
        if (Get-Module -ListAvailable -Name $moduleName) {
            Write-Host "  $moduleName already installed" -ForegroundColor Green
            $Skipped += $moduleName
        } else {
            Write-Host "  Installing $moduleName..." -ForegroundColor Yellow
            try {
                Install-Module -Name $moduleName -Scope CurrentUser -Force -AllowClobber -SkipPublisherCheck
                Write-Host "  $moduleName installed" -ForegroundColor Green
                $Installed += $moduleName
            } catch {
                Write-Host "  Failed: $moduleName - $_" -ForegroundColor Red
                $Failed += $moduleName
            }
        }
    }
}

# ============================================================================
# Summary
# ============================================================================

Write-Host ""
Write-Host "========================================" -ForegroundColor Green
Write-Host "   Installation Complete!" -ForegroundColor Green
Write-Host "========================================" -ForegroundColor Green
Write-Host ""
Write-Host "Installed: $($Installed.Count) tools" -ForegroundColor Green
Write-Host "Skipped (already installed): $($Skipped.Count) tools" -ForegroundColor Cyan
if ($Failed.Count -gt 0) {
    Write-Host "Failed: $($Failed -join ', ')" -ForegroundColor Yellow
}
Write-Host ""
Write-Host "Restart PowerShell to load new tools into PATH" -ForegroundColor Yellow
